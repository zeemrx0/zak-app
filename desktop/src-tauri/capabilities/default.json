{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window only: core defaults, the app commands, the folder picker and window dragging for the overlay title bar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "allow-kit-run",
    "allow-kit-source-get",
    "allow-kit-source-set",
    "allow-tool-status",
    "allow-cli-install",
    "allow-installs",
    "allow-project-add",
    "allow-project-remove",
    "allow-models-state",
    "allow-models-preview",
    "allow-models-save",
    "allow-templates-list",
    "allow-templates-get",
    "allow-templates-save",
    "allow-templates-reset"
  ]
}
